{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "Live CSS Queries",
  "version": "1.0.0",
  "description": "See live CSS selector results with instant highlights and a focused Side Panel match inspector",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "commands": {
    "_execute_action": {
      "description": "Toggle Live CSS Queries (+ Side Panel)"
    },
    "toggle-selector-input": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Toggle selector input"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "fonts.css",
        "tokens.css",
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "tokens.css",
        "fonts.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "action": {
    "default_title": "Live CSS Queries",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}

